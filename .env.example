# Credentials for the TimescaleDB container defined in docker-compose.yml.
POSTGRES_PORT=5433
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgres://fathom:change_me@127.0.0.1:5433/fathom

# Contract to record. Any Binance USD-M perpetual works (ETHUSDT, SOLUSDT, ...).
INSTRUMENT_SYMBOL=BTCUSDT

# Height of one heatmap row, in quote currency units.
PRICE_BUCKET_SIZE=10

# Width of one heatmap column, in milliseconds.
FRAME_INTERVAL_MS=1000

# Fraction of the mid price recorded above and below the touch.
RECORDED_PRICE_RANGE_RATIO=0.02

# Levels further than this fraction from mid are dropped from the local book.
# Bounds memory; must stay comfortably wider than RECORDED_PRICE_RANGE_RATIO.
RETAINED_PRICE_RANGE_RATIO=0.10

# How often a fresh REST snapshot repairs the top of the local book.
DEEP_REPAIR_INTERVAL_MS=300000

# Gateway. 0.0.0.0 binds the LAN so a phone on the same network can reach it.
GATEWAY_PORT=8787
GATEWAY_HOST=0.0.0.0

# Secret the shared link has to carry; it is traded for a cookie on first use.
# Empty leaves every route open, which is only acceptable on a trusted network.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
FATHOM_ACCESS_TOKEN=
# Set to true when serving over an https tunnel, so the cookie is marked Secure.
# The gateway refuses to start with this true and no access token.
FATHOM_TUNNELLED=false

# Where the built viewer is, relative to the gateway's working directory.
# Blank falls back to dist/app: it must never resolve to the project itself.
VIEWER_DIST_PATH=dist/app
