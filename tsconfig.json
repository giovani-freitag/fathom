{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2024"
    ],
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/build.tsbuildinfo"
  },
  "include": [
    "types/**/*.d.ts",
    "src/shared/**/*.ts",
    "src/database/**/*.ts",
    "src/server/**/*.ts",
    "src/workers/**/*.ts"
  ],
  "exclude": [
    "src/database/browser/**",
    "src/workers/browser/**"
  ]
}
