{
  "name": "fathom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Order book depth sounding — records and renders resting liquidity as a Bookmap-style heatmap.",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "tsc --build",
    "build:viewer": "pnpm --filter @fathom/viewer build",
    "clean": "tsc --build --clean && rm -rf apps/viewer/dist coverage",
    "typecheck": "tsc --build --force && pnpm --filter @fathom/viewer typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "database:up": "docker compose up -d",
    "database:down": "docker compose down",
    "database:logs": "docker compose logs -f timescaledb",
    "collector": "pnpm --filter @fathom/collector start",
    "gateway": "pnpm --filter @fathom/gateway start",
    "viewer": "pnpm --filter @fathom/viewer dev",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
