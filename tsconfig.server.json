{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist/server"
  },
  "include": [
    "src/main-collector.ts",
    "src/main-gateway.ts",
    "src/delay.ts",
    "src/book/**/*.ts",
    "src/venue/**/*.ts",
    "src/trades/**/*.ts",
    "src/recording/**/*.ts",
    "src/archive/**/*.ts",
    "src/api/**/*.ts"
  ]
}
