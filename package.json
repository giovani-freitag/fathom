{
  "name": "fathom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Order book depth sounding \u2014 records and renders resting liquidity as a Bookmap-style heatmap.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "collector": "node --env-file-if-exists=.env dist/workers/collector.js",
    "gateway": "node --env-file-if-exists=.env dist/server/main.js",
    "dev": "vite",
    "build": "tsc --build && vite build",
    "build:server": "tsc --build tsconfig.server.json",
    "build:viewer": "vite build",
    "clean": "tsc --build --clean && rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/app/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "database:up": "docker compose up -d",
    "database:down": "docker compose down",
    "database:logs": "docker compose logs -f timescaledb",
    "verify": "npm run lint && npm run typecheck && npm test",
    "build:node": "tsc --build",
    "build:app": "vite build"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/websocket": "^11.3.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.1",
    "lucide-react": "^1.34.0",
    "pg": "^8.16.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/colors": "^3.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
