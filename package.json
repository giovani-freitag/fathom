{
  "name": "fathom",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Order book liquidity heat map — records resting depth every second, because book history cannot be backfilled.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "collector": "node --env-file-if-exists=.env dist/workers/collector.js",
    "gateway": "node --env-file-if-exists=.env dist/server/main.js",
    "build": "tsc --build && vite build",
    "build:node": "tsc --build",
    "build:app": "vite build",
    "clean": "tsc --build --clean && rm -rf dist coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/app/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:report": "node scripts/report-coverage.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage",
    "database:up": "docker compose up -d",
    "database:down": "docker compose down",
    "database:logs": "docker compose logs -f timescaledb",
    "migrate": "bash scripts/migrate.sh",
    "build:demo": "vite build --config vite.demo.config.ts",
    "dev:demo": "vite --config vite.demo.config.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/websocket": "^11.3.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.1",
    "lucide-react": "^1.34.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/colors": "^3.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
